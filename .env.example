# Copie para .env e ajuste. NUNCA versione credenciais reais.

# Conexão da aplicação (papel sem privilégios, sujeito a RLS). Use uma senha forte.
DATABASE_URL=postgres://saas_app:troque-esta-senha@localhost:5432/saas_dev
# Conexão do dono das tabelas: migrações e operações de sistema (cadastro, webhooks, jobs).
# Somente no servidor. Nunca exponha ao navegador.
DATABASE_URL_OWNER=postgres://saas_owner:troque-esta-senha@localhost:5432/saas_dev

# URL pública da aplicação (links em e-mails, convites).
APP_URL=http://localhost:3000

# Segredo para acionar jobs agendados via HTTP (/api/cron/billing). Gere com: openssl rand -hex 32
CRON_SECRET=

# Envio de e-mails: "console" (somente desenvolvimento) ou "resend" (pendente de credenciais).
MAIL_PROVIDER=console
MAIL_FROM="Gestão Financeira <nao-responda@example.com>"
RESEND_API_KEY=

# Provedor de pagamentos: "manual" (baixa manual pelo painel admin) ou "asaas".
PAYMENT_PROVIDER=manual
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
# Token configurado no painel Asaas para autenticar webhooks (cabeçalho asaas-access-token).
ASAAS_WEBHOOK_TOKEN=

# Nível de log: debug | info | warn | error
LOG_LEVEL=info
